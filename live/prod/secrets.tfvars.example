# Copy to secrets.tfvars (gitignored, never committed) and fill in real
# values. aws_region and github_owner are NOT here — they're set as plain
# `inputs` in this directory's terragrunt.hcl since neither is sensitive.

# --- observe.nestjs.com ---
observe_app_key    = ""
observe_app_secret = ""

# --- Neon Postgres: one database, one role per service (scripts/neon-bootstrap.sql) ---
database_host = ""
database_name = ""
# openssl rand -base64 24 | tr -d '/+=' for each; the same values go to scripts/neon-bootstrap.sql
database_passwords = {
  platform    = ""
  catalog     = ""
  customer    = ""
  inventory   = ""
  sales       = ""
  finance     = ""
  integration = ""
  insight     = ""
}

# --- Upstash Redis ---
redis_host     = ""
redis_port     = 6379
redis_password = ""

# --- pbl-api access-token signing key (RS256) ---
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
auth_jwt_private_key = ""

# --- service-to-service token (openssl rand -hex 32) and marketplace credential key (openssl rand -base64 32) ---
internal_s2s_token                = ""
integration_credential_master_key = ""

# --- dead-letter alarm recipient (optional) ---
alert_email = ""

# --- pbl-api auth secrets (openssl rand -base64 32, two separate values:
# forgot-password and confirm-email) ---
auth_forgot_secret        = ""
auth_confirm_email_secret = ""

# --- pbl-api Swagger (/api-docs) Basic Auth — give this to frontend devs ---
swagger_user     = ""
swagger_password = ""

# --- Resend ---
resend_api_key    = ""
resend_from_email = "onboarding@resend.dev"
resend_from_name  = "pbl-api"
