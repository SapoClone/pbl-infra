# Copy to terraform.tfvars (gitignored) and fill in real values.

project_id = "CHANGE_ME"

api_github_owner  = "<GITHUB_OWNER>"
api_github_repo   = "pbl-api"
mail_github_owner = "<GITHUB_OWNER>"
mail_github_repo  = "pbl-mail-service"

# Override non_secret_env / mail_non_secret_env from variables.tf here once
# you have Neon/Upstash/Resend values, and (after the first apply) the
# Cloud Tasks wiring values from `terraform output`.
